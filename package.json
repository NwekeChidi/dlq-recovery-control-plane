{
  "name": "taming-dlqs",
  "version": "0.1.0",
  "private": true,
  "description": "Conference demo for Taming Dead-Letter Queues: A Serverless Framework for Triage, Patch, and Replay",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "demo:reset": "ts-node --prefer-ts-exts src/scripts/reset-demo.ts",
    "demo:seed": "ts-node --prefer-ts-exts src/scripts/seed.ts",
    "demo:status": "ts-node --prefer-ts-exts src/scripts/status.ts",
    "demo:break-downstream": "ts-node --prefer-ts-exts src/scripts/break-downstream.ts",
    "demo:restore-downstream": "ts-node --prefer-ts-exts src/scripts/restore-downstream.ts",
    "demo:smoke": "ts-node --prefer-ts-exts src/scripts/smoke.ts",
    "recovery:start": "ts-node --prefer-ts-exts src/scripts/start-recovery.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1127.0",
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/client-lambda": "3.1127.0",
    "@aws-sdk/client-sqs": "3.1127.0",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@aws/durable-execution-sdk-js": "2.4.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.1.4",
    "@types/aws-lambda": "8.10.160",
    "@types/jest": "29.5.14",
    "@types/node": "^24",
    "aws-cdk": "2.1136.0",
    "esbuild": "0.25.12",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
