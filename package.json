{
  "name": "taming-dlqs",
  "version": "0.1.0",
  "private": true,
  "description": "Conference demo for Taming Dead-Letter Queues: A Serverless Framework for Triage, Patch, and Replay",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "reset": "ts-node --prefer-ts-exts src/scripts/reset-demo.ts",
    "seed:sqs": "ts-node --prefer-ts-exts src/scripts/seed.ts",
    "seed:eb": "ts-node --prefer-ts-exts src/scripts/seed-eventbridge.ts",
    "seed:sns": "ts-node --prefer-ts-exts src/scripts/seed-sns.ts",
    "seed:ddb": "ts-node --prefer-ts-exts src/scripts/seed-stream.ts",
    "status": "ts-node --prefer-ts-exts src/scripts/status.ts",
    "status:eb": "ts-node --prefer-ts-exts src/scripts/status-eventbridge.ts",
    "status:sns": "ts-node --prefer-ts-exts src/scripts/status-sns.ts",
    "status:ddb": "ts-node --prefer-ts-exts src/scripts/status-stream.ts",
    "break-downstream": "ts-node --prefer-ts-exts src/scripts/break-downstream.ts",
    "restore-downstream": "ts-node --prefer-ts-exts src/scripts/restore-downstream.ts",
    "smoke:sqs": "ts-node --prefer-ts-exts src/scripts/smoke.ts",
    "smoke:eb": "ts-node --prefer-ts-exts src/scripts/smoke-eventbridge.ts",
    "smoke:sns": "ts-node --prefer-ts-exts src/scripts/smoke-sns.ts",
    "smoke:ddb": "ts-node --prefer-ts-exts src/scripts/smoke-stream.ts",
    "recovery:start:sqs": "ts-node --prefer-ts-exts src/scripts/start-recovery.ts",
    "recovery:start:eb": "ts-node --prefer-ts-exts src/scripts/start-recovery-eventbridge.ts",
    "recovery:start:sns": "ts-node --prefer-ts-exts src/scripts/start-recovery-sns.ts",
    "recovery:start:ddb": "ts-node --prefer-ts-exts src/scripts/start-recovery-stream.ts",
    "slides:pptx": "node slides/build-pptx.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1127.0",
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/client-eventbridge": "3.1127.0",
    "@aws-sdk/client-lambda": "3.1127.0",
    "@aws-sdk/client-sns": "3.1127.0",
    "@aws-sdk/client-sqs": "3.1127.0",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@aws/durable-execution-sdk-js": "2.4.0",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.1.4",
    "@types/aws-lambda": "8.10.160",
    "@types/jest": "29.5.14",
    "@types/node": "^24",
    "aws-cdk": "2.1136.0",
    "esbuild": "0.25.12",
    "jest": "29.7.0",
    "pptxgenjs": "4.0.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
